{
  "kind": "collectionType",
  "collectionName": "blog_posts",
  "info": {
    "singularName": "blog-post",
    "pluralName": "blog-posts",
    "displayName": "Blog Post",
    "description": "Articles shown on the blog archive and individual blog post pages"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "slug": {
      "type": "uid",
      "required": true
    },
    "title": {
      "type": "string",
      "required": true
    },
    "excerpt": {
      "type": "text",
      "required": true
    },
    "content": {
      "type": "richtext",
      "required": true
    },
    "coverImage": {
      "type": "string",
      "required": true
    },
    "coverImageAlt": {
      "type": "string",
      "required": true
    },
    "author": {
      "type": "string",
      "required": true,
      "default": "Bayan Signage"
    },
    "category": {
      "type": "string"
    },
    "publishedDate": {
      "type": "date",
      "required": true
    },
    "metaTitle": {
      "type": "string",
      "required": true
    },
    "metaDescription": {
      "type": "text",
      "required": true
    }
  }
}
